@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="container hero-grid">
        <div>
            <p class="eyebrow">Your table is waiting</p>
            <h1>Good evenings begin with an easy reservation.</h1>
            <p class="hero-lead">Explore local restaurants, browse their menus, and find the right table for everything from quick lunches to milestone dinners.</p>
            <div class="hero-actions">
                <a class="button" href="/restaurants">Explore restaurants</a>
                <a class="text-link" href="/account/register">Create an account</a>
            </div>
            <dl class="hero-stats">
                <div><dt>Simple</dt><dd>Book in a few clear steps</dd></div>
                <div><dt>Transparent</dt><dd>See menus and tables first</dd></div>
                <div><dt>Connected</dt><dd>Keep every update in one place</dd></div>
            </dl>
        </div>
        <div class="hero-card" aria-label="Reservation process">
            <span class="hero-card__number">01</span>
            <p>Choose a restaurant</p>
            <span class="hero-card__number">02</span>
            <p>Pick a time and table</p>
            <span class="hero-card__number">03</span>
            <p>Receive your confirmation</p>
        </div>
    </div>
</section>

<section class="feature-section container" aria-labelledby="experience-title">
    <div class="section-heading">
        <p class="eyebrow">Built for every occasion</p>
        <h2 id="experience-title">From weekday lunches to unforgettable nights.</h2>
    </div>
    <div class="feature-grid">
        <article><span>01</span><h3>Find the right setting</h3><p>Compare restaurant details, opening hours, and table options before you decide.</p></article>
        <article><span>02</span><h3>Browse before you arrive</h3><p>Preview menu categories, availability, and prices at your own pace.</p></article>
        <article><span>03</span><h3>Stay in the loop</h3><p>Keep reservation changes and restaurant updates together in your account.</p></article>
    </div>
</section>

<section class="home-cta">
    <div class="container home-cta__inner">
        <div>
            <p class="eyebrow">Ready when you are</p>
            <h2>Make room for something delicious.</h2>
        </div>
        <a class="button" href="/restaurants">Find your table</a>
    </div>
</section>
