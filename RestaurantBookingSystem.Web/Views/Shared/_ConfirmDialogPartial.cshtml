<dialog class="confirm-dialog" data-confirm-dialog aria-labelledby="confirm-dialog-title" aria-describedby="confirm-dialog-message">
    <form method="dialog">
        <p class="eyebrow">Confirm action</p>
        <h2 id="confirm-dialog-title" data-confirm-title>Are you sure?</h2>
        <p id="confirm-dialog-message" data-confirm-message>This action may change stored data.</p>
        <div class="confirm-dialog__actions">
            <button class="button button--ghost" value="cancel">Go back</button>
            <button class="button button--danger" value="confirm">Confirm</button>
        </div>
    </form>
</dialog>
