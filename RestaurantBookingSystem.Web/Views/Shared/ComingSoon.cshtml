@model ComingSoonViewModel
@{
    ViewData["Title"] = Model.Title;
}
<section class="message-page container">
    <p class="eyebrow">@Model.Eyebrow</p>
    <h1>@Model.Title</h1>
    <p>@Model.Description</p>
    <div class="message-page__actions">
        <a class="button" href="/">Return home</a>
        <a class="text-link" href="/restaurants">Explore restaurants</a>
    </div>
</section>
