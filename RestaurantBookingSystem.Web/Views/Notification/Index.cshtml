@model NotificationListViewModel
@{
    ViewData["Title"] = "Notifications";
    Layout = "_CustomerLayout";
}

<section class="customer-page-heading">
    <div>
        <p class="eyebrow">Account updates</p>
        <h1>Notifications</h1>
        <p>Reservation confirmations, changes, and cancellations are collected here.</p>
    </div>
    @if (!Model.HasError)
    {
        <div class="unread-summary"><strong>@Model.UnreadCount</strong><span>unread</span></div>
    }
</section>

@if (Model.HasError)
{
    <section class="customer-state customer-state--error">
        <span aria-hidden="true">!</span>
        <div><h2>Notifications could not be loaded</h2><p>@Model.ErrorMessage</p><a class="text-link" href="/notifications">Try again</a></div>
    </section>
}
else if (Model.Notifications.Count == 0)
{
    <section class="customer-state">
        <span aria-hidden="true">0</span>
        <div><h2>You are all caught up</h2><p>New reservation updates will appear here.</p></div>
    </section>
}
else
{
    <div class="notification-list">
        @foreach (var notification in Model.Notifications)
        {
            <article class="notification-item @(notification.IsRead ? "notification-item--read" : string.Empty)">
                <span class="notification-item__dot" aria-hidden="true"></span>
                <div class="notification-item__body">
                    <div><h2>@notification.Title</h2><time datetime="@notification.CreatedAt.ToString("O")">@notification.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy - HH:mm")</time></div>
                    <p>@notification.Message</p>
                </div>
                @if (!notification.IsRead)
                {
                    <form action="/notifications/@notification.NotificationId/read" method="post">
                        @Html.AntiForgeryToken()
                        <button class="button button--ghost button--small" type="submit">Mark as read</button>
                    </form>
                }
            </article>
        }
    </div>
}
