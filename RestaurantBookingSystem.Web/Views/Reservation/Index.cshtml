@model ReservationListViewModel
@{
    ViewData["Title"] = "My reservations";
    Layout = "_CustomerLayout";
}

<section class="customer-page-heading">
    <div>
        <p class="eyebrow">My account</p>
        <h1>My reservations</h1>
        <p>Review upcoming visits, adjust the details, or cancel a reservation you no longer need.</p>
    </div>
    <a class="button" href="/restaurants">Find a restaurant</a>
</section>

@if (Model.HasError)
{
    <section class="customer-state customer-state--error">
        <span aria-hidden="true">!</span>
        <div><h2>Reservations could not be loaded</h2><p>@Model.ErrorMessage</p><a class="text-link" href="/reservations">Try again</a></div>
    </section>
}
else if (Model.Items.Count == 0)
{
    <section class="customer-state">
        <span aria-hidden="true">0</span>
        <div><h2>No reservations yet</h2><p>Your restaurant plans will appear here after you submit a reservation request.</p><a class="text-link" href="/restaurants">Explore restaurants</a></div>
    </section>
}
else
{
    <div class="reservation-list">
        @foreach (var item in Model.Items)
        {
            var reservation = item.Reservation;
            var statusClass = reservation.Status.ToLowerInvariant();
            <article class="reservation-card @(item.IsCancelled ? "reservation-card--cancelled" : string.Empty)">
                <div class="reservation-date">
                    <span>@reservation.Date.ToString("MMM")</span>
                    <strong>@reservation.Date.Day.ToString("00")</strong>
                    <small>@reservation.Date.Year</small>
                </div>
                <div class="reservation-card__main">
                    <div class="reservation-card__heading">
                        <div><p class="eyebrow">Reservation #@reservation.ReservationId</p><h2>@item.RestaurantName</h2></div>
                        <span class="status-pill status-pill--@statusClass">@reservation.Status</span>
                    </div>
                    <dl class="reservation-facts">
                        <div><dt>Time</dt><dd>@reservation.StartTime.ToString("HH:mm") - @reservation.EndTime.ToString("HH:mm")</dd></div>
                        <div><dt>Table</dt><dd>@item.TableNumber</dd></div>
                        <div><dt>Party size</dt><dd>@reservation.GuestCount @(reservation.GuestCount == 1 ? "guest" : "guests")</dd></div>
                    </dl>
                    @if (!item.IsCancelled)
                    {
                        <div class="reservation-card__actions">
                            <a class="button button--ghost button--small" href="/reservations/@reservation.ReservationId/edit">Edit reservation</a>
                            <form action="/reservations/@reservation.ReservationId/cancel" method="post" data-confirm-form data-confirm-title="Cancel this reservation?" data-confirm-message="The reservation will be marked as cancelled and can no longer be edited.">
                                @Html.AntiForgeryToken()
                                <button class="link-button link-button--danger" type="submit">Cancel reservation</button>
                            </form>
                        </div>
                    }
                </div>
            </article>
        }
    </div>
}

<partial name="_ConfirmDialogPartial" />
