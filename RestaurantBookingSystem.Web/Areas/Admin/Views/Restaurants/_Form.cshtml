@model AdminRestaurantFormViewModel
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<div class="form-row">
    <div class="form-field">
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="field-validation"></span>
    </div>
    <div class="form-field">
        <label asp-for="Phone"></label>
        <input asp-for="Phone" />
        <span asp-validation-for="Phone" class="field-validation"></span>
    </div>
</div>
<div class="form-field">
    <label asp-for="Address"></label>
    <input asp-for="Address" />
    <span asp-validation-for="Address" class="field-validation"></span>
</div>
<div class="form-row">
    <div class="form-field">
        <label asp-for="OpenTime"></label>
        <input asp-for="OpenTime" type="time" />
        <span asp-validation-for="OpenTime" class="field-validation"></span>
    </div>
    <div class="form-field">
        <label asp-for="CloseTime"></label>
        <input asp-for="CloseTime" type="time" />
        <span asp-validation-for="CloseTime" class="field-validation"></span>
    </div>
</div>
